# ---------------------------------------------------------------------------
# DrillMind AI — backend environment
# Copy to `backend/.env` and fill in. `backend/.env` is gitignored.
# ---------------------------------------------------------------------------

# Groq (OpenAI-compatible) LLM credentials for the AI Drilling Copilot.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Groq model used for the copilot + report narrative.
GROQ_MODEL=openai/gpt-oss-120b

# Groq OpenAI-compatible base URL (change only for a proxy/gateway).
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Deterministic seed for the synthetic well/formation/incident corpus.
DRILLMIND_SEED=20260214

# Comma-separated browser origins allowed to call the API.
DRILLMIND_CORS=http://localhost:5173,http://127.0.0.1:5173

# If the LLM is unreachable, the copilot falls back to a deterministic
# analytical answer built from the retrieval engine. Set to 0 to disable.
DRILLMIND_ALLOW_OFFLINE_COPILOT=1
